# salami — WiFi(WCN7850) 运行时配置覆盖
# 与 salami.config 搭配使用（debug/release 构建链均可挂）。
#
# ath12k 必须为模块（=m）：内建会在 rootfs 挂载前 probe，
# request_firmware_direct 找不到 amss.bin(-2)，后续 MHI 全部 -110。
# rootfs 起来后手动 modprobe ath12k_wifi7（约 90s probe 超时属预期）。
CONFIG_ATH12K=m
CONFIG_ATH12K_PCI=m

# MHI 寄存器取证：/sys/kernel/debug/mhi/mhi0/regdump
CONFIG_MHI_BUS_DEBUG=y
