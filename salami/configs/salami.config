# salami (OnePlus 11, SM8550) base kernel fragment — bring-up profile
# Modelled after lmi/configs/m1.config; display/touch/audio/camera/modem
# drivers intentionally deferred until their bring-up rounds.

# boot / core
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_FORCE=y
CONFIG_RD_GZIP=y
# OnePlus kalama ABL is a UEFI loader: kernel must have EFI stub to be loaded
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
# 128KB 会被 initcall_debug + dyndbg 刷爆，导致早期启动日志被覆盖（0~31s 空洞取证需要）
CONFIG_LOG_BUF_SHIFT=21
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DYNAMIC_DEBUG_CORE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y

# rootfs
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
# CONFIG_SCSI_UFS_CRYPTO is not set
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_PCIE=y

# serial / console
CONFIG_CMDLINE_BOOL=y
# dyndbg dwc3 +p 已移除：与 initcall_debug 一起刷爆 dmesg 环形缓冲，早期日志全丢
CONFIG_CMDLINE="earlycon=efifb keep_bootcon console=tty0 loglevel=7 initcall_debug ignore_loglevel clk_ignore_unused pd_ignore_unused deferred_probe_timeout=0 pcie_aspm=off"
CONFIG_CMDLINE_FORCE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# simpledrm keeps the EFI framebuffer alive as console through full boot
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_TER16x32=y

# SoC
CONFIG_PINCTRL_SM8550=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8550=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_TCSRCC_8550=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_INTERCONNECT_QCOM_SM8550=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_GENI_SE=y

# regulators / power
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_POWER_SUPPLY=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_QCOM_PMIC_GLINK=y

# input / keys
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_PM8941_RESIN=y

# i2c / dma
CONFIG_DMA_ENGINE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y

# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
# dwc3 ULPI ops（sheng 参考；部分 USB2 PHY 路径需要）
CONFIG_USB_DWC3_ULPI=y
# USB host 键盘（USB host 通道）
CONFIG_HID_SUPPORT=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y

# PCIE / MHI / WLAN / BT
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_QCOM=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_FW_LOADER=y
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y
# WLAN: WCN7850 (kiwi) — firmware now lives in ath12k/WCN7850/hw2.0 upstream
# 模块化等 WiFi 运行时设置在 salami-wifi.config 中覆盖
CONFIG_CFG80211=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211=y
CONFIG_MAC80211_DEBUG_MENU=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_ATH12K=y
CONFIG_ATH12K_PCI=y
CONFIG_ATH12K_DEBUG=y
CONFIG_ATH12K_DEBUGFS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# geni i2c 的 DMA 引擎（=m 会卡死全部 i2c 设备）与 PMIC 通道
CONFIG_QCOM_GPI_DMA=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
CONFIG_SERIAL_DEV_BUS=y

# process / cgroup (server-style rootfs later)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX98_PTYS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_PSI=y
CONFIG_CHECKPOINT_RESTORE=y
