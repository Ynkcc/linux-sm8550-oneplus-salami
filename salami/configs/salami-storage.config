# salami — 存储配置（btrfs 单池 + 子卷，方案 B）
#
# 设备布局（不拆分分区，用子卷做系统/数据分离）：
#   /dev/sda14 = 整个 userdata（数 GiB 镜像装入后 btrfs resize max 撑满，~457GiB）
#     LABEL=salami-rootfs  subvol=@           -> /
#     LABEL=salami-rootfs  subvol=@home       -> /home
#     subvol=@snapshots                       回滚点（快照）
#
# 数据保留更新：① pacman 原地升级（先快照）；② 新建 @new 子卷装新 rootfs 后
# 与 @ 改名交换；③ 快照直接 rename 回滚。均不触碰 @home。
#
# btrfs 必须内建（=y）：initramfs 阶段就要挂载根分区，模块化会因
# 无 userspace/kmod 而挂不上。zstd 压缩供 compress=zstd 使用。

CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
