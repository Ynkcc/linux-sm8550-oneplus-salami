# salami — 参考树（sheng-7.2 / aston sm8550.config）对比后采纳的增量配置
# 2026-09-21 筛选，仅保留 bring-up / 面板轮直接相关项。

# UFS
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_SCSI_SCAN_ASYNC=y

# geni i2c 的 DMA 引擎（=m 会卡死全部 i2c 设备）
CONFIG_QCOM_GPI_DMA=y

# RTC（PMK8550）
CONFIG_RTC_DRV_PM8XXX=y

# 显示/相机/视频时钟控制器（面板轮前提）
CONFIG_SM_CAMCC_8550=y
CONFIG_SM_DISPCC_8550=y
CONFIG_SM_VIDEOCC_8550=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# TypeC / UCSI 生态
CONFIG_UCSI_PMIC_GLINK=y

# 远程处理器调试（ADSP/CDSP 轮）
CONFIG_REMOTEPROC_CDEV=y
CONFIG_RPMSG_CHAR=y

# modem 共享内存 / 温控 / 带宽监控
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_ICC_BWMON=y

# USB gadget 串口控制台 + HID（host 键盘）
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_HID_BATTERY_STRENGTH=y
