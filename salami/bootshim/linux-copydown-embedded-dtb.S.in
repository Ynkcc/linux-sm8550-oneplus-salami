.section .text
.global _start
_start:
	b shim_entry
	.word 0
	.quad 0x0
	.quad image_end - _start
	.quad 0xa
	.quad 0
	.quad 0
	.quad 0
	.byte 0x41, 0x52, 0x4d, 0x64
	.word 0

shim_entry:
	adrp x5, copy_entry
	add x5, x5, :lo12:copy_entry
	br x5

.balign 0x200000
linux_image:
	.incbin "@LINUX_IMAGE@"
.balign 8
linux_image_end:

.balign 0x1000
copy_entry:
	adrp x0, _start
	add x0, x0, :lo12:_start
	adrp x1, linux_image
	add x1, x1, :lo12:linux_image
	adrp x2, linux_image_end
	add x2, x2, :lo12:linux_image_end
	mov x7, x0
	sub x8, x2, x1
	add x8, x7, x8

copy_loop:
	cmp x1, x2
	b.hs copy_done
	ldr x3, [x1], #8
	str x3, [x0], #8
	b copy_loop

copy_done:
	mrs x5, ctr_el0
	ubfx x5, x5, #16, #4
	mov x6, #4
	lsl x5, x6, x5
	mov x6, x7

dcache_clean_loop:
	cmp x6, x8
	b.hs dcache_clean_done
	dc cvau, x6
	add x6, x6, x5
	b dcache_clean_loop

dcache_clean_done:
	adrp x6, runtime_dtb
	add x6, x6, :lo12:runtime_dtb
	adrp x8, runtime_dtb_end
	add x8, x8, :lo12:runtime_dtb_end

dtb_clean_loop:
	cmp x6, x8
	b.hs dtb_clean_done
	dc cvau, x6
	add x6, x6, x5
	b dtb_clean_loop

dtb_clean_done:
	dsb ish
	ic iallu
	dsb ish
	isb
	adrp x4, _start
	add x4, x4, :lo12:_start
	adrp x0, runtime_dtb
	add x0, x0, :lo12:runtime_dtb
	mov x1, xzr
	mov x2, xzr
	mov x3, xzr
	br x4

.balign 0x1000
runtime_dtb:
	.incbin "@RUNTIME_DTB@"
.balign 8
runtime_dtb_end:

.balign 0x1000
image_end:
